<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6A205">

    <TextView
        android:id="@+id/tv_title"
        style="@style/AnsimTextView.Bold.White"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="62dp"
        android:text="긴급상황 발생"
        android:textColor="#FF0000"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        style="@style/AnsimTextView.Bold.White"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="5초후에 관제센터로 자동 신고됩니다."
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_notice"
        style="@style/AnsimTextView.Bold.White"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="긴급상황이 아니거나 SOS버튼을 잘못 누른 경우\n신고취소 버튼을 눌러주세요"
        android:textColor="#595857"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_notice">

        <ImageView
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:src="@drawable/report_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/report_counter"
            style="@style/AnsimTextView.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="8dp"
            android:text="5"
            android:textColor="#FC0000"
            android:textSize="72sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!--TextView
            style="@style/AnsimTextView.Bold.White"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="긴급신고까지"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/report_counter"
            style="@style/AnsimTextView.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="5"
            android:textColor="#FFFF64"
            android:textSize="64sp" />

        <TextView
            style="@style/AnsimTextView.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="초"
            android:textColor="#FFFF64"
            android:textSize="64sp" />

        <TextView
            style="@style/AnsimTextView.Bold.White"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="남았습니다."
            android:textSize="15sp" /-->

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btn_report"
        style="@style/AnsimButton.Pop.Red"
        android:layout_width="136dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:text="즉시 신고"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_content" />

    <Button
        android:id="@+id/btn_cancellations"
        style="@style/AnsimButton.Pop.Blue"
        android:layout_width="136dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:text="신고 취소"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_report" />

</androidx.constraintlayout.widget.ConstraintLayout>